{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vlearn.local/schemas/content-units.schema.json",
  "title": "VLearn Content Units",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_slug", "content_units"],
  "properties": {
    "schema_version": {"const": "vlearn_content_units_v1"},
    "source_slug": {"type": "string", "minLength": 1},
    "content_units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "content_unit_id", "source_id", "source_type", "page_no",
          "start_seconds", "end_seconds", "locator", "content", "content_sha256"
        ],
        "properties": {
          "content_unit_id": {"type": "string", "minLength": 1},
          "source_id": {"type": "string", "minLength": 1},
          "source_type": {"type": "string", "minLength": 1},
          "page_no": {"type": ["integer", "null"], "minimum": 1},
          "start_seconds": {"type": ["number", "null"], "minimum": 0},
          "end_seconds": {"type": ["number", "null"], "exclusiveMinimum": 0},
          "locator": {"type": ["string", "null"]},
          "content": {"type": "string", "minLength": 1},
          "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "anyOf": [
          {"required": ["page_no"], "properties": {"page_no": {"type": "integer"}}},
          {
            "required": ["start_seconds", "end_seconds"],
            "properties": {
              "start_seconds": {"type": "number"},
              "end_seconds": {"type": "number"}
            }
          },
          {"required": ["locator"], "properties": {"locator": {"type": "string", "minLength": 1}}}
        ]
      }
    }
  }
}

